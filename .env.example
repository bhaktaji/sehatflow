# ============================================================================
# SehatFlow — Production Environment Configuration (.env.example)
# ============================================================================
# Pre-configured with secure, clinic-optimized production defaults.
# - Backend / Docker Compose reads these values when launching PostgreSQL 16
#   and the Spring Boot 3.3.5 API server.
# - Android Secrets Gradle Plugin ignores server-only keys via `ignoreList`
#   in `app/build.gradle.kts` so backend credentials are NEVER embedded inside
#   the client APK's BuildConfig.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Spring Boot Runtime & Clinic Session UX
# ----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# 12-hour session timeout covers a full outpatient clinic shift (morning +
# evening OPD) so Doctors and Receptionists are never logged out mid-patient.
APP_SESSION_TIMEOUT=12h

# ----------------------------------------------------------------------------
# 2. PostgreSQL 16 Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_DB=sehatflow_clinic_prod
POSTGRES_USER=sehatflow_db_admin
POSTGRES_PASSWORD=Sf9xK2mP7vQ4nL8wR3tY6uJ1hG5bN0cZ

APP_DB_URL=jdbc:postgresql://postgres:5432/sehatflow_clinic_prod
APP_DB_USER=sehatflow_db_admin
APP_DB_PASSWORD=Sf9xK2mP7vQ4nL8wR3tY6uJ1hG5bN0cZ

# HikariCP Connection Pool (tuned for multi-chamber concurrent clinic traffic)
APP_DB_POOL_MAX=20
APP_DB_POOL_MIN=5

# ----------------------------------------------------------------------------
# 3. Authentication, Cookie Security & Production Hardening
# ----------------------------------------------------------------------------
# Enforces HTTPS-only transmission for the JSESSIONID session cookie
APP_COOKIE_SECURE=true

# Lax + HttpOnly + XSRF-TOKEN double-submit cookie protects against CSRF
# while preventing false session drops across mobile network switches
APP_COOKIE_SAME_SITE=Lax

# BCrypt work factor 12 (~250ms hash time: strong protection, instant login UX)
APP_BCRYPT_STRENGTH=12

# Disables demo clinic/staff credential seeding in production
APP_SEED_ENABLED=false

# Disables public OpenAPI / Swagger UI exposure in production
APP_SWAGGER_ENABLED=false

# ----------------------------------------------------------------------------
# 4. Per-IP Rate Limiting (Balanced for Shared Clinic Wi-Fi NAT)
# ----------------------------------------------------------------------------
# Allows multiple staff/patients on shared clinic Wi-Fi to sign in and poll
# live token status smoothly while blocking brute-force & scraping attacks.
APP_LOGIN_RATE=30
APP_PUBLIC_RATE=180
