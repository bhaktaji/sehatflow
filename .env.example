# ============================================================================
# SehatFlow — Production Environment Configuration (.env.example)
# ============================================================================
# Pre-configured with secure, clinic-optimized production defaults.
# - Backend / Docker Compose reads these values when launching PostgreSQL 16
#   and the Spring Boot 3.3.5 API server.
# - Android Secrets Gradle Plugin ignores server-only keys via `ignoreList`
#   in `app/build.gradle.kts` so backend and merchant credentials are NEVER
#   embedded inside the client APK's BuildConfig.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Spring Boot Runtime & Clinic Session UX
# ----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# 12-hour session timeout covers a full outpatient clinic shift (morning +
# evening OPD) so Doctors and Receptionists are never logged out mid-patient.
APP_SESSION_TIMEOUT=12h

# ----------------------------------------------------------------------------
# 2. PostgreSQL 16 Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_DB=sehatflow_clinic_prod
POSTGRES_USER=sehatflow_db_admin
POSTGRES_PASSWORD=Sf9xK2mP7vQ4nL8wR3tY6uJ1hG5bN0cZ

APP_DB_URL=jdbc:postgresql://postgres:5432/sehatflow_clinic_prod
APP_DB_USER=sehatflow_db_admin
APP_DB_PASSWORD=Sf9xK2mP7vQ4nL8wR3tY6uJ1hG5bN0cZ

# HikariCP Connection Pool (tuned for multi-chamber concurrent clinic traffic)
APP_DB_POOL_MAX=20
APP_DB_POOL_MIN=5

# ----------------------------------------------------------------------------
# 3. Authentication, Cookie Security & Production Hardening
# ----------------------------------------------------------------------------
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
APP_BCRYPT_STRENGTH=12
APP_SEED_ENABLED=false
APP_SWAGGER_ENABLED=false

# ----------------------------------------------------------------------------
# 4. Per-IP Rate Limiting (Balanced for Shared Clinic Wi-Fi NAT)
# ----------------------------------------------------------------------------
APP_LOGIN_RATE=30
APP_PUBLIC_RATE=180

# ----------------------------------------------------------------------------
# 5. Razorpay Merchant & Webhook Credentials (SERVER-ONLY — NEVER IN APK)
# ----------------------------------------------------------------------------
# Replace with your live Razorpay Dashboard credentials (Settings -> API Keys
# and Settings -> Webhooks) so customer payments settle directly to your
# verified merchant bank account.
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_YOUR_MERCHANT_KEY_ID
RAZORPAY_KEY_SECRET=rzp_secret_REPLACE_WITH_YOUR_MERCHANT_SECRET
RAZORPAY_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET
RAZORPAY_MERCHANT_VPA=sehatflow@razorpay

# ----------------------------------------------------------------------------
# 6. Official In-App Update Version Manifest Metadata
# ----------------------------------------------------------------------------
APP_UPDATE_LATEST_VERSION_CODE=1
APP_UPDATE_LATEST_VERSION_NAME=1.0
APP_UPDATE_MIN_REQUIRED_VERSION_CODE=1
APP_UPDATE_APK_URL=https://api.sehatflow.app/releases/SehatFlow-1.0-release.apk
APP_UPDATE_APK_SHA256=8cfbff8cb079d87efadcda873182b782ead5850c87fa0e49494ca3906cf79d57
APP_UPDATE_APK_SIZE_BYTES=22731677
APP_UPDATE_SIGNING_CERT_SHA256=1123931df3516f4e816e792e1348ba9e4a548c769eb46e71677691f13af88be0

# ----------------------------------------------------------------------------
# 7. Direct UPI & Google Pay Configuration (Injected into client BuildConfig)
# ----------------------------------------------------------------------------
# Placeholders for public repository. Real credentials are kept in gitignored .env
SEHATFLOW_UPI_VPA=clinic@okhdfcbank
SEHATFLOW_UPI_NAME=SehatFlow Healthcare
SEHATFLOW_UPI_NUMBER=9876543210
