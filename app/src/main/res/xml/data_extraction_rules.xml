<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive credentials, session tokens, local database, and prescription files -->
        <exclude domain="database" path="clinic_queue_local.db" />
        <exclude domain="database" path="clinic_queue_local.db-journal" />
        <exclude domain="database" path="clinic_queue_local.db-wal" />
        <exclude domain="database" path="clinic_queue_local.db-shm" />
        <exclude domain="sharedpref" path="clinic_queue_session" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="prescriptions/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="clinic_queue_local.db" />
        <exclude domain="database" path="clinic_queue_local.db-journal" />
        <exclude domain="database" path="clinic_queue_local.db-wal" />
        <exclude domain="database" path="clinic_queue_local.db-shm" />
        <exclude domain="sharedpref" path="clinic_queue_session" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="prescriptions/" />
    </device-transfer>
</data-extraction-rules>
